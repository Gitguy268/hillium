{
  "manifest_version": 3,
  "name": "Hillium Home",
  "short_name": "Hillium",
  "version": "0.1.0",
  "description": "Offline new tab, tracking-parameter cleaner, Tor and proxy switch with kill switch, WebRTC leak block, and SearXNG fallback.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Hillium",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "declarativeNetRequest",
    "favicon",
    "privacy",
    "proxy",
    "search",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "url_cleaner",
        "enabled": true,
        "path": "url-cleaner.json"
      }
    ]
  }
}
